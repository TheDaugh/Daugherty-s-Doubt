---
import Base from './Base.astro';
import Stack from '../components/Stack.astro';
import { seriesItems, titleOf } from '../lib/articles';
import { series as seriesMeta } from '../data/series';
interface Props { id: string; data: any; }
const { id, data } = Astro.props;
const items = data.seriesSlug ? await seriesItems(data.seriesSlug) : [];
const at = items.findIndex((i) => i.kind === 'article' && i.entry.id === id);
const prev = at > 0 ? items[at - 1] : undefined;
const next = at >= 0 ? items[at + 1] : undefined;
const meta = data.seriesSlug ? seriesMeta[data.seriesSlug] : undefined;
const isDraft = data.status?.toUpperCase().includes('DRAFT');
---
<Base title={data.title} description={data.subtitle}>
  <div class="wrap article-grid">
    {data.seriesSlug && meta && (
      <aside class="side" aria-label="Series">
        <h2><a href={`/series/${data.seriesSlug}/`}>{meta.title}</a></h2>
        <Stack slug={data.seriesSlug} current={id} />
      </aside>
    )}
    <article>
      <header class="article-head">
        {data.series && <p class="crumb"><a href={`/series/${data.seriesSlug}/`}>{data.series}</a></p>}
        <h1>{data.title}</h1>
        {data.subtitle && <p class="sub">{data.subtitle}</p>}
      </header>
      {isDraft && <p class="draft-banner">{data.status}</p>}
      <div class="prose"><slot /></div>
      {(prev || next) && (
        <nav class="pager" aria-label="Series navigation">
          {prev?.kind === 'article' ? <a href={`/articles/${prev.entry.id}/`}><small>Previous</small>{titleOf(prev)}</a> : <span></span>}
          {next?.kind === 'article'
            ? <a class="next" href={`/articles/${next.entry.id}/`}><small>Next</small>{titleOf(next)}</a>
            : next ? <span class="off"><small>Next, coming</small>{titleOf(next)}</span> : null}
        </nav>
      )}
    </article>
  </div>
</Base>
