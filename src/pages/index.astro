---
import Base from '../layouts/Base.astro';
import Stack from '../components/Stack.astro';
import { published } from '../lib/articles';
import { series } from '../data/series';
import { site } from '../data/site';

const all = await published();
const standalone = all.filter((a) => !a.data.seriesSlug).sort((a, b) => a.data.title.localeCompare(b.data.title));
const slugs = Object.keys(series);
---
<Base title={site.name}>
  <div class="wrap">
    <section class="hero">
      <h1>{site.tagline}</h1>
      <p>{site.description}</p>
    </section>

    {slugs.map((s) => (
      <section class="series-card">
        <div>
          <h2><a href={`/series/${s}/`}>{series[s].title}</a></h2>
          <p>{series[s].description}</p>
        </div>
        <Stack slug={s} />
      </section>
    ))}

    {standalone.length > 0 && (
      <>
        <h2 class="section-title">More articles</h2>
        <ul class="courses">
          {standalone.map((a) => (
            <li class="course">
              <h3><a href={`/articles/${a.id}/`}>{a.data.title}</a></h3>
              {a.data.subtitle && <p>{a.data.subtitle}</p>}
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</Base>
