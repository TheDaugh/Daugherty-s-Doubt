{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "seriesSlug": {
      "type": "string"
    },
    "seriesOrder": {
      "type": "number"
    },
    "tier": {
      "default": "hub",
      "type": "string",
      "enum": [
        "hub",
        "spoke"
      ]
    },
    "status": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}