---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About">
  <div class="wrap">
    <div class="page">
      <h1>About</h1>
      <p>{site.name} is written by {site.author}. It sets out the arguments for the Christian faith and the strongest objections to them, one line of an argument at a time.</p>
      <p>Each argument gets two pieces: a survey of the case for it, and a debate that presses it against its critics. Terms of art are marked in the text with a dotted underline; hover or tap one for its definition, or read the glossary at the foot of the article.</p>
      <p>Articles marked as coming are linked from published pieces and are not yet written.</p>
    </div>
  </div>
</Base>
